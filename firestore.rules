rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /products/{id} { allow read, write: if request.auth != null; }
  match /sales/{id} { allow read, write: if request.auth != null; }
  match /stockOps/{id} { allow read, write: if request.auth != null; }
  match /heldCarts/{id} { allow read, write: if request.auth != null; }
  match /returns/{id} { allow read, write: if request.auth != null; }
  match /users/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
 }
}
