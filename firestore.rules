rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ОБЩИЙ КАТАЛОГ:
    // все авторизованные пользователи могут читать товары;
    // записывать/изменять/удалять товары могут авторизованные пользователи.
    // Если в вашем проекте есть отдельная роль admin, эти write-правила
    // можно дополнительно ограничить через custom claims.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Персональные данные пользователя.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
